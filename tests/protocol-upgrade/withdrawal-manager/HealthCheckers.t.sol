    address[][] openTermLoans = [
        cashUSDCOpenTermLoans,
        blueChipSecuredUSDCOpenTermLoans,
        highYieldCorpUSDCOpenTermLoans,
        highYieldCorpWETHOpenTermLoans,
        securedLendingUSDCOpenTermLoans,
        lendAndLongUSDC1OpenTermLoans,
        lendAndLongUSDC2OpenTermLoans,
        syrupUSDCOpenTermLoans,
        syrupUSDTOpenTermLoans
    ];

    address[][] users = [
        cashUSDCUsers,
        blueChipSecuredUSDCUsers,
        highYieldCorpUSDCUsers,
        highYieldCorpWETHUsers,
        securedLendingUSDCUsers,
        lendAndLongUSDC1Users,
        lendAndLongUSDC2Users,
        syrupUSDCUsers,
        syrupUSDTUsers
    ];

    function setUp() public override {
        vm.createSelectFork(vm.envString("ETH_RPC_URL"), 23211261);

        _upgradeWithdrawalManagers();

        _collateralAsset      = WBTC;
        _feeManager           = feeManager;
        _liquidatorFactory    = liquidatorFactory;
        _openTermLoanFactory  = openTermLoanFactory;
        _fixedTermLoanFactory = fixedTermLoanFactoryV2;

        lps.push(makeAddr("lp1"));
        lps.push(makeAddr("lp2"));
        lps.push(makeAddr("lp3"));
        lps.push(makeAddr("lp4"));
        lps.push(makeAddr("lp5"));

        protocolHealthCheckerV2    = address(new ProtocolHealthChecker());
        openTermLoanHealthChecker  = address(new OpenTermLoanHealthChecker());
        fixedTermLoanHealthChecker = address(new FixedTermLoanHealthChecker());
        lpHealthChecker            = address(new LPHealthChecker());
    }

    /// forge-config: default.fuzz.runs = 10
    function testFork_withdrawalManagerUpgrade_protocolHealthChecker(uint256 seed) public {
        address[] memory emptyFixedTermLoanArray = new address[](0);

        for (uint256 i; i < withdrawalManagerQueuesToUpgrade.length; ++i) {
            address withdrawalManager = withdrawalManagerQueuesToUpgrade[i];
            address pool              = IWithdrawalManagerQueue(withdrawalManager).pool();
            address poolManager       = IPool(pool).manager();

            assertProtocolInvariants(poolManager, protocolHealthCheckerV2);
            assertOpenTermLoanInvariants(poolManager, openTermLoans[i], openTermLoanHealthChecker);
            assertFixedTermLoanInvariants(poolManager, emptyFixedTermLoanArray, fixedTermLoanHealthChecker);
            assertLPInvariants(poolManager, users[i], lpHealthChecker);

            executeFuzzedSetup(seed, pool);

            address[] memory newFixedTermLoans = getAllActiveFixedTermLoans();
            address[] memory newOpenTermLoans  = getAllActiveOpenTermLoans();

            for (uint256 j; j < newOpenTermLoans.length; ++j) {
                openTermLoans[i].push(newOpenTermLoans[j]);
            }

            for (uint256 j; j < lps.length; ++j) {
                users[i].push(lps[j]);
            }

            assertProtocolInvariants(poolManager, protocolHealthCheckerV2);
            assertOpenTermLoanInvariants(poolManager, openTermLoans[i], openTermLoanHealthChecker);
            assertFixedTermLoanInvariants(poolManager, newFixedTermLoans, fixedTermLoanHealthChecker);
            assertLPInvariants(poolManager, users[i], lpHealthChecker);
        }
    }

    function executeFuzzedSetup(uint256 seed, address pool) internal {
        delete _fixedTermLoans;
        delete _openTermLoans;
        delete loans;

        setAddresses(pool);

        for (uint256 j; j < lps.length; ++j) {
            uint256 maxDeposit         = 100_000_000e6;
            uint256 liquidityCap       = IPoolManager(IPool(pool).manager()).liquidityCap();
            uint256 totalAssets        = IPool(pool).totalAssets();
            uint256 availableLiquidity = liquidityCap > totalAssets ? liquidityCap - totalAssets : 0;
            uint256 depositAmount      = maxDeposit > availableLiquidity ? availableLiquidity : maxDeposit;

            if (depositAmount != 0) {
                deposit(pool, lps[j], depositAmount);
            }
        }

        fuzzedSetup(FTL_LOAN_COUNT, OTL_LOAN_COUNT, LOAN_ACTION_COUNT, STRATEGY_ACTION_COUNT, seed);
    }

