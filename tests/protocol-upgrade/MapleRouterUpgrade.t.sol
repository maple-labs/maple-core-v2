contract MapleRouterUpgrade1InchSanityTests is ProtocolUpgradeBase, ProtocolActions, MapleRouterProtocolUpgradeBase {

    uint256 defaultUSDCDepositAmount = 100_000e6;
    uint256 usdsSellAmount           = 100_000e18;

    address usdsDepositor;
    address usdsToken;
    address swapRouter;

    IMapleRouterLike mapleRouterLike;
    IMapleRouter     mapleRouter;

    function setUp() external {
        vm.createSelectFork(vm.envString("ETH_RPC_URL"), 22624425);

        upgradeProtocol();

        mapleRouterLike = IMapleRouterLike(mapleRouterProxy);
        mapleRouter     = IMapleRouter(mapleRouterProxy);

        usdsDepositor = 0x1AB4973a48dc892Cd9971ECE8e01DcC7688f8F23; // Bitget Hot Wallet
        usdsToken     = 0xdC035D45d973E3EC169d2276DDab16f1e407384F;
        swapRouter    = 0x111111125421cA6dc452d289314280a0f8842A65; // 1inch Swap Router

        vm.prank(governor);
        mapleRouter.setAllowedRouterFunction(swapRouter, hex"07ed2379", true);  // Adding the 1Inch swap router function selector

        vm.prank(governor);
        mapleRouter.setAllowedAllowanceHolder(swapRouter, true);  // Allow the 1inch swap router as the allowance holder

        erc20_approve(usdsToken, usdsDepositor, address(mapleRouter), type(uint256).max);

        allowLender(syrupUSDCPoolManager, usdsDepositor);

        setPermissionAdmin(mapleRouterLike.ppm(), address(mapleRouter), true);

        vm.label(usdc,                      "USDC");
        vm.label(USDT,                      "USDT");
        vm.label(syrupUSDCPoolManager,      "Syrup USDC Pool Manager");
        vm.label(syrupUSDCPool,             "Syrup USDC Pool");
        vm.label(mapleRouterProxy,          "Maple Router Proxy");
        vm.label(mapleRouterImplementation, "Maple Router Implementation");
        vm.label(swapRouter,                "1Inch Swap Router");
        vm.label(usdsDepositor,             "USDS Depositor");
        vm.label(usdsToken,                 "USDS");
        vm.label(mapleRouterLike.ppm(),     "Pool Permission Manager");
    }

    function testFork_mapleRouter_deposit_usds_WithSwapToUSDCWith1Inch_no_slippage() external {
        IMapleRouter.Permit        memory permit;
        IMapleRouter.Swap          memory swap;
        IMapleRouter.Authorization memory authorization;

        swap.router = swapRouter;
        // The below hex is generated with the 1Inch API to perform a swap from USDS to USDC.
        swap.calldata_    = hex"";
        swap.calldata_    = replaceTakerAddressIn1InchData(swap.calldata_, address(mapleRouter));  // Ensures that the calldata has the correct mapleRouter address.
        swap.minAssetsOut = 100000e6;  // If you change the swap.calldata_ or fork block you will need to update this value.

        IPool pool = IPool(IPoolManager(syrupUSDCPoolManager).pool());

        uint256 expectedSharesMinted  = pool.convertToExitShares(swap.minAssetsOut);
        uint256 poolUSDCBalanceBefore = IERC20(USDC).balanceOf(syrupUSDCPool);

        vm.prank(usdsDepositor);
        mapleRouter.deposit(
            syrupUSDCPoolManager,
            usdsToken,
            usdsSellAmount,
            "",
            permit,
            swap,
            authorization
        );

        assertEq(
            IERC20(USDC).balanceOf(syrupUSDCPool),
            poolUSDCBalanceBefore + swap.minAssetsOut,
            "Pool Balance Mismatch"
        );

		assertApproxEqAbs(
            IERC20(syrupUSDCPool).balanceOf(usdsDepositor),
            expectedSharesMinted,
            1
        );
    }

}

contract MapleRouterUpgradeSkimTests is ProtocolUpgradeBase, ProtocolActions, MapleRouterProtocolUpgradeBase {

    IMapleRouter mapleRouter;

    function setUp() external {
        vm.createSelectFork(vm.envString("ETH_RPC_URL"), 22624425);

        upgradeProtocol();

        mapleRouter = IMapleRouter(mapleRouterProxy);
    }

    function testFork_mapleRouter_skim_failure_zero_destination() external {
        vm.prank(governor);
        vm.expectRevert("MR:S:ZERO_ADDRESS");
        mapleRouter.skim(USDC, address(0));
    }

    function testFork_mapleRouter_failure_unauthorised() external {
        vm.expectRevert("MR:NOT_AUTHORIZED");
        mapleRouter.skim(address(0), address(this));
    }

    function testFork_mapleRouter_failure_nothing_to_skim() external {
        vm.prank(governor);
        vm.expectRevert("MR:S:NO_TOKEN_TO_SKIM");
        mapleRouter.skim(USDS, address(this));
    }

    function testFork_mapleRouter_skim() external {
        deal(USDS, address(mapleRouter), 100_000e18);

        uint256 usdsBalanceBefore        = IERC20(USDS).balanceOf(address(this));
        uint256 usdsExpectedBalanceAfter = IERC20(USDS).balanceOf(address(mapleRouter));

        vm.prank(governor);
        mapleRouter.skim(USDS, address(this));

        uint256 usdsBalanceAfter = IERC20(USDS).balanceOf(address(this));

        assertEq(
            IERC20(USDS).balanceOf(address(mapleRouter)),
            0
        );

        assertEq(
            usdsBalanceAfter,
            usdsExpectedBalanceAfter + usdsBalanceBefore
        );
    }

}

contract MapleRouterSetAllowedAllowanceHolderTests is MapleRouterUpgradeSuccessTests {

    address allowanceHolder = address(1337);

    function test_setAllowedAllowanceHolder_notAdmin() external {
        vm.expectRevert("MR:NOT_AUTHORIZED");
        mapleRouter.setAllowedAllowanceHolder(allowanceHolder, true);
    }

    function test_setAllowedAllowanceHolder_zeroAddress() external {
        vm.prank(governor);
        vm.expectRevert("MR:SAAH:ZERO_ADDRESS");
        mapleRouter.setAllowedAllowanceHolder(address(0), true);
    }

    function test_setAllowedAllowanceHolder_success() external {
        assertEq(mapleRouter.allowedAllowanceHolders(allowanceHolder), false);

        vm.prank(governor);
        mapleRouter.setAllowedAllowanceHolder(allowanceHolder, true);

        assertEq(mapleRouter.allowedAllowanceHolders(allowanceHolder), true);
    }

}
