contract MapleRouterProtocolUpgradeBase is Test {

    function signPermit(
        IERC20 asset,
        Vm.Wallet memory owner,
        uint256 value,
        uint256 deadline,
        address mapleRouter
    )
        internal returns (uint8 v, bytes32 r, bytes32 s)
    {
        bytes32 digest = keccak256(abi.encodePacked(
            '\x19\x01',
            asset.DOMAIN_SEPARATOR(),
            keccak256(abi.encode(
                asset.PERMIT_TYPEHASH(),
                owner.addr,
                mapleRouter,
                value,
                asset.nonces(owner.addr),
                deadline
            ))
        ));

        ( v, r, s ) = vm.sign(owner, digest);
    }

    function signAuthorization(
        Vm.Wallet memory signer,
        address msgSender,
        uint256 bitmap,
        uint256 deadline,
        address mapleRouter
    )
        internal returns (uint8 v, bytes32 r, bytes32 s)
    {
        bytes32 digest = keccak256(abi.encodePacked(
            '\x19\x01',
            block.chainid,
            mapleRouter,
            msgSender,
            IMapleRouter(mapleRouter).authorizationNonce(signer.addr),
            bitmap,
            deadline
        ));

        ( v, r, s ) = vm.sign(signer, digest);
    }

    function replaceTakerAddressIn0xData(
        bytes memory data,
        address newAddress
    ) internal pure returns (bytes memory) {
        // The address appears at hex indexes 424–464
        uint256 startIndex = 424 / 2;
        require(data.length >= startIndex + 20, "Data too short");

        bytes20 newAddressBytes = bytes20(newAddress);

        bytes memory result = new bytes(data.length);

        for (uint256 i = 0; i < startIndex; i++) {
            result[i] = data[i];
        }

        for (uint256 i = 0; i < 20; i++) {
            result[startIndex + i] = newAddressBytes[i];
        }

        for (uint256 i = startIndex + 20; i < data.length; i++) {
            result[i] = data[i];
        }

        return result;
    }

    function replaceTakerAddressIn1InchData(
        bytes memory data,
        address newAddress
    ) internal pure returns (bytes memory) {
        // The address appears at hex indexes 288-328
        uint256 startIndex = 288 / 2;
        require(data.length >= startIndex + 20, "Data too short");

        bytes20 newAddressBytes = bytes20(newAddress);

        bytes memory result = new bytes(data.length);

        for (uint256 i = 0; i < startIndex; i++) {
            result[i] = data[i];
        }

        for (uint256 i = 0; i < 20; i++) {
            result[startIndex + i] = newAddressBytes[i];
        }

        for (uint256 i = startIndex + 20; i < data.length; i++) {
            result[i] = data[i];
        }

        return result;
    }

}

