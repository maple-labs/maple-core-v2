    function testFork_mapleRouter_deposit_usdc_WithoutAuth_WithoutSwap_WithoutPermit() external {
        IMapleRouter.Permit        memory permit;
        IMapleRouter.Swap          memory swap;
        IMapleRouter.Authorization memory authorization;

        uint256 poolUSDCBalanceBefore =           IERC20(USDC).balanceOf(syrupUSDCPool);
        uint256 depositorSyrupUSDCBalanceBefore = IERC20(syrupUSDCPool).balanceOf(usdcDepositor);

        IPool pool = IPool(IPoolManager(syrupUSDCPoolManager).pool());

        uint256 expectedSharesMinted = pool.convertToExitShares(defaultUSDCDepositAmount);

        vm.prank(usdcDepositor);
        mapleRouter.deposit(
            syrupUSDCPoolManager,
            usdc,
            defaultUSDCDepositAmount,
            "",
            permit,
            swap,
            authorization
        );

        assertEq(
            IERC20(USDC).balanceOf(syrupUSDCPool),
            poolUSDCBalanceBefore + defaultUSDCDepositAmount,
            "Pool balance mismatch"
        );

        assertApproxEqAbs(
            IERC20(syrupUSDCPool).balanceOf(usdcDepositor),
            depositorSyrupUSDCBalanceBefore + expectedSharesMinted,
            1
        );
    }

